# =============================================================================
# FREE PAYMENT REMINDER AGENT CONFIGURATION
# =============================================================================

# 1. AI Engine (100% Free Gemini API key from https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Your Receiving Payment / Bank Account Details
PAYMENT_BANK_NAME="Standard Chartered Bank"
PAYMENT_ACCOUNT_TITLE="Hassam Tech Solutions"
PAYMENT_ACCOUNT_NUMBER="PK36SCBL0000001123456701"
PAYMENT_IBAN="PK36SCBL0000001123456701"
PAYMENT_SWIFT="SCBLPKKA"
PAYMENT_LINK=""
SUPPORT_CONTACT="+1-555-0199 / billing@mycompany.com"

# 3. Reminder Rules
ADVANCE_NOTICE_DAYS=3
REMINDER_COOLDOWN_DAYS=2
MAX_REMINDERS=5

# 4. Dispatcher Channel: "simulation" | "email_to_sms" | "telegram" | "twilio"
DISPATCHER_MODE=simulation

# Telegram Bot (Free) - If using DISPATCHER_MODE=telegram
TELEGRAM_BOT_TOKEN=

# Email-to-SMS Gateway (Free) - If using DISPATCHER_MODE=email_to_sms
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Twilio (Optional) - If using DISPATCHER_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
